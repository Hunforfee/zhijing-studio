# Copy to .env, add your key, then restart the local server.
OPENAI_API_KEY=
IMAGE_MODEL=gpt-image-2
OPENAI_BASE_URL=https://api.openai.com/v1
PORT=4173
# Keep loopback for a cloud server behind an HTTPS reverse proxy.
# Managed Node hosting may require HOST=0.0.0.0 and platform access control.
HOST=127.0.0.1
# Optional override of deploy/site-config.json when the website domain changes.
PUBLIC_ORIGIN=
# Cloud deployment: inject through server environment / hosting secrets.
# Keep blank in Git. See deploy/README.md.
ZHJ_DEPLOYMENT_KEY=
# Optional: override the local Sub2API relay address on the server.
SUB2API_BASE_URL=
